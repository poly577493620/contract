# 不要把真实密钥提交到仓库。下面 JSON 可配置一个或多个 OpenAI-compatible 端点。
# 每个模型可分别配置 api_path、temperature、response_format、max_output_tokens、timeout_seconds、max_retries、
# thinking（enabled/disabled/none）和 reasoning_effort（low/high/max）。程序只向已知支持的模型发送推理参数。
# GLM-5.3/GLM-5.3-Flash 当前必须启用 thinking，可使用 reasoning_effort=low；DeepSeek V4 可关闭 thinking；
# Kimi K3 不发送 thinking/reasoning_effort。
# Kimi K3 实测要求 temperature=1；未填写时程序会使用该能力默认值。
# 只有核验过官方来源后才填写 price_input_per_million、price_output_per_million、price_currency、
# price_source_url 和 price_verified_at（YYYY-MM-DD）；单位固定为 per_million_tokens，未知价格保持空缺。
# SMART_COMPLIANCE_MODEL_ENDPOINTS=[{"name":"kimi","provider":"OpenCode Go","model":"kimi-k3","base_url":"https://opencode.ai/zen/go","api_key":"REPLACE_ME","temperature":1,"max_output_tokens":4096,"timeout_seconds":300,"max_retries":2,"thinking":"none"}]
SMART_COMPLIANCE_MODEL_ENDPOINTS=[]
SMART_COMPLIANCE_REQUEST_TIMEOUT_SECONDS=240
SMART_COMPLIANCE_MAX_RETRIES=2
SMART_COMPLIANCE_MAX_UPLOAD_MB=25
SMART_COMPLIANCE_MAX_PDF_PAGES=200
SMART_COMPLIANCE_OCR_CACHE_DIR=outputs/ocr-cache
SMART_COMPLIANCE_OCR_DEFAULT_DPI=300
SMART_COMPLIANCE_OCR_RETRY_DPI=360
SMART_COMPLIANCE_OCR_MIN_TEXT_SCORE=0.50
SMART_COMPLIANCE_OCR_LOW_CONFIDENCE_SCORE=0.85
SMART_COMPLIANCE_OCR_MIN_MEDIAN_CONFIDENCE=0.85
SMART_COMPLIANCE_OCR_MAX_LOW_CONFIDENCE_RATIO=0.15
SMART_COMPLIANCE_OCR_MAX_FRAGMENT_LINE_RATIO=0.35
SMART_COMPLIANCE_LOG_LEVEL=INFO
